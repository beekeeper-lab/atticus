[Unit]
Description=Check every minute whether a reminder has come due
Documentation=https://github.com/beekeeper-lab/atticus/blob/main/skills/reminders/SKILL.md

[Timer]
# EVERY MINUTE, and that is not extravagant here. A reminder resolves to a minute
# ("remind me at four", "in twenty minutes"), so the cadence IS the accuracy of
# the feature — on the processor's 5-minute tick, "in five minutes" would land
# anywhere in a ten-minute window. The run costs one short-lived Python process
# that reads a JSONL file and, almost always, does nothing: no git, no agent, no
# credential, no network unless something is actually due.
OnCalendar=*:*:00

# OnCalendar, NOT OnUnitActiveSec — the same fix every other timer here spells
# out. A monotonic reference is lost on a daemon-reload, after which systemd parks
# the timer at next_elapse=infinity and it never fires again while still reporting
# enabled AND active. atticus-vault-site.timer did exactly this for 76 minutes on
# 2026-07-29. A reminder timer that never fires is invisible in the worst way:
# nothing errors, reminders are simply never delivered.

# Catch up after downtime. Only works with OnCalendar= — systemd.timer(5) says
# Persistent= is a no-op on monotonic timers.
#
# On a minutely timer this buys one thing specifically: the FIRST run after the
# box comes back happens immediately rather than at the next minute boundary, so
# reminders that came due during an outage are delivered as the machine returns.
# What happens to them then is reminders.py's decision, not systemd's — inside
# ATTICUS_REMINDER_MAX_LATE_HOURS they fire with "this was due at four, 3h ago";
# past it they are marked expired and reported in one grouped push.
Persistent=true

# No RandomizedDelaySec. Everywhere else it exists to avoid colliding with the
# rest of the internet's cron jobs against APIs we do not own; here the whole
# point is to be on time, and the only endpoint is the operator's own ntfy topic.
AccuracySec=10s

[Install]
WantedBy=timers.target
