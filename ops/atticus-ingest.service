[Unit]
Description=Atticus ingest — pull new recordings into the vault
Documentation=https://github.com/beekeeper-lab/atticus/blob/main/docs/SPEC.md
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot

# Adjust to the deployment path on WarDog.
WorkingDirectory=%h/atticus

# MUST be the fetchers venv, not system python. poller.py launches the
# transport via sys.executable, and the Plaud web fetcher needs Playwright.
ExecStart=%h/.local/share/claude-fetchers/venv/bin/python %h/atticus/ingest/poller.py

# NOT ~/.config/ai/env. That file holds OPENAI_API_KEY, which ingest never uses
# — transcription and the wake adjudicator are both processor-side. Loading it
# put an unnecessary credential in the environment of the one process that drives
# a full browser against a third-party site, and the fetcher subprocess inherited
# it. Credential minimisation: ingest needs the vault and the Plaud session only.
EnvironmentFile=-%h/atticus/ops/.env

# systemd USER units run with PATH=/usr/local/bin:/usr/bin — no ~/.local/bin.
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin

# REQUIRED, not hygiene. Every sandbox option below that needs a mount
# namespace puts a *user* unit in a user namespace where root-owned files
# appear as nobody:nobody. ssh then refuses to read
# /etc/ssh/ssh_config.d/*.conf ("Bad owner or permissions") and every push to
# the vault fails — silently, because git's stderr goes nowhere useful.
# `ssh -F <file>` suppresses /etc/ssh/ssh_config and its includes outright,
# which is the whole fix. Confirmed on Fedora 43 against a namespaced unit.
Environment="GIT_SSH_COMMAND=ssh -F %h/.ssh/config"

# Both roles can run on one host now, sharing one ops/.env. Override the
# author here so the vault history still says which half wrote each commit.
# Must come after EnvironmentFile= — later definitions win.
Environment="ATTICUS_GIT_AUTHOR_NAME=Atticus Ingest"

# A pass downloads audio over a headless browser; give it room but not forever.
TimeoutStartSec=1800

# The single-instance lock lives here. Without this, ProtectSystem=strict
# makes the runtime dir read-only and the lock cannot be taken at all.
# Preserve=yes so a manual run and a timed run share one lock rather than
# taking different ones and racing anyway.
RuntimeDirectory=atticus
RuntimeDirectoryPreserve=yes

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectKernelTunables=true
ProtectKernelModules=true
RestrictSUIDSGID=true

# Needs write to: the vault, the Playwright session, and its browser cache.
# install.sh appends the vault path here.
ReadWritePaths=%h/atticus %h/.local/share/claude-fetchers %h/.cache

StandardOutput=journal
StandardError=journal
SyslogIdentifier=atticus-ingest

[Install]
WantedBy=default.target
