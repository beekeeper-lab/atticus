# Atticus — environment template
#
#   cp ops/.env.example ops/.env    then fill in ops/.env
#
# ops/.env is gitignored. This file is committed and must never contain
# a real secret.
#
# TWO ROLES, which may live on one host or two:
#
#   ingest     Plaud Cloud → vault repo            must be always-on
#   processor  vault → transcribe/execute → vault  may be offline; work waits
#
# Roles are capabilities, not machine names. Deploy the same file
# wherever you run either role; each reads its own section plus SHARED.
#
# ─────────────────────────────────────────────────────────────────────
# NOTE ON PLAUD AUTH: the official Plaud CLI is PAYWALLED and unused —
# see ADR-002. No password lives here either; auth is a seeded browser
# session on disk. Ingest and processing may share one host; the
# credential-isolation trade-off that allows is ADR-003.
# ─────────────────────────────────────────────────────────────────────
#
# THE VAULT IS YOURS, NOT OURS. Nothing in this repo names a particular
# vault. Clone your own private repo with inbox/, processed/, failures/
# and .state/, point ATTICUS_VAULT_PATH at it, give the host a deploy
# key with write access, and you are done.


# ══ SHARED — both hosts ══════════════════════════════════════════════

# Absolute path to the atticus-vault checkout on THIS host.
# Each host has its own clone; the paths need not match.
ATTICUS_VAULT_PATH=/srv/atticus/atticus-vault

# Git identity for automated commits. Distinguish the hosts so the vault
# history shows which side of the pipeline made each commit.
#   ingest    → "Atticus Ingest"
#   processor → "Atticus Processor"
# When both roles share a host, the ingest unit overrides this itself.
ATTICUS_GIT_AUTHOR_NAME=Atticus
ATTICUS_GIT_AUTHOR_EMAIL=atticus@localhost

# Both hosts push to the same repo. Bounded retry on rebase conflict
# before quarantining and notifying. See SPEC §4.3.
ATTICUS_PUSH_RETRIES=3

# Expire raw audio after this many days. 0 = keep forever.
# Transcripts and agent output are NEVER expired — only the audio.
# The vault contains recordings of other people who did not consent to
# permanent retention. Removes audio from the working tree, NOT from git
# history; see ops/retention.py for what would actually delete it.
ATTICUS_AUDIO_RETENTION_DAYS=30


# Failure notifications (SPEC T-70). ntfy topic URL, or any endpoint
# accepting a POST body. Blank disables them.
#
# SET THIS. It is the only thing standing between you and a silently
# dead pipeline. The signature failure here is a Plaud session that
# expired: ingest then reports "0 new recordings" forever, which is
# exactly what a quiet weekend looks like, while recordings pile up in
# the cloud unnoticed.
ATTICUS_NOTIFY_URL=

# One alarm per condition per this many hours. The ingest timer
# rediscovers a dead session every 15 minutes; alarming each time is how
# you learn to ignore the alarm.
ATTICUS_ALARM_THROTTLE_HOURS=6

# DEBUG | INFO | WARNING | ERROR
ATTICUS_LOG_LEVEL=INFO

# ── results ──────────────────────────────────────────────────────────
# Where finished-recording pushes go. Blank = reuse ATTICUS_NOTIFY_URL.
# Split them onto a separate topic if pipeline alarms start competing with
# routine results for your attention.
ATTICUS_RESULT_NOTIFY_URL=

# Public base URL of the vault browser, no trailing slash. Used to build a
# tappable link to the page a recording produced:
#     <base>/docs/<stem>/<file>.html
# Blank = no links in notifications, which is correct if you publish no site.
ATTICUS_SITE_BASE_URL=http://forge/atticus

# Push for GATED notes too. Off by default: a wearable overhears a lot and
# notes are the common case. Turn on to catch the failure that matters — a
# misheard wake word silently filing a real command as a note.
ATTICUS_NOTIFY_NOTES=false

# How much of what you said appears in a push notification.
#   title   - just "Atticus finished" and the link. Nothing spoken.
#   summary - the first 60 characters.
#   full    - up to 180 characters (default).
# These travel through a third-party push service and land on lock screens,
# watches and phone backups. "full" suits a single operator on a private
# topic; consider "title" otherwise.
ATTICUS_NOTIFICATION_DETAIL=full




# ══ INGEST ═══════════════════════════════════════════════════════════

# THE TRANSPORT IS A PLUGGABLE EXECUTABLE. ingest/poller.py shells out to
# this and requires only that it implement:
#     <fetcher> whoami --json
#     <fetcher> list --days N --json   → {"recordings":[{id,created_at,...}]}
#     <fetcher> audio <id> -o <path>
#     exit 0 ok · 2 usage · 3 auth dead · 4 transient · 5 upstream changed
# Swap this line to change transports; nothing else changes.
ATTICUS_FETCHER=ingest/plaud_web.py
ATTICUS_FETCHER_TIMEOUT=300

# Web-fetcher: seeded Playwright session directory.
# LEAVE BLANK unless the session lives somewhere unusual — the fetcher already
# defaults to ~/.local/share/claude-fetchers/sessions for the running user.
# A hardcoded path here pointing at the wrong home is an auth failure every
# tick, which is how this was first found.
PLAUD_SESSION_ROOT=

# Lookback window for the recording list. The seen ledger handles dedupe,
# so overlap is free — and it is what makes a missed poll window
# harmless, so do not trim this to save an API call.
PLAUD_POLL_DAYS=2

# Overrides the hostname used to name this host's dedupe ledger
# (.state/seen-<host>.jsonl) and to identify it in alarms. Blank = the real
# hostname, which is almost always what you want. Set it only if two checkouts on
# one machine must keep separate ledgers.
ATTICUS_HOST=

# Direct-BLE path (SPEC option 1) — CLOSED. Neither setting does anything useful
# on a NotePin S: its firmware reports portVersion 20, so it requires an RSA
# pre-handshake keyed by a credential Plaud issues under a B2B agreement, plus
# ChaCha20 framing whose key exchange is undecoded. See
# docs/decisions/ADR-005-direct-device-access-is-closed.md. Kept only so the
# research tooling in ingest/ has documented inputs; leave both blank.
#
# The pin's Bluetooth address is also a rotating RPA — it changed between two
# scans minutes apart — so pinning it is wrong even in principle. Discover by
# name instead.
# PLAUD_BLE_ADDRESS=
#
# Stable client identifier for ingest/ble_sync.py. NOT a credential: the pin
# cannot verify it, it only has to stay the same across reconnects.
# `./ingest/ble_sync.py init-token` writes one to ~/.config/atticus/ble-token.
# ATTICUS_BLE_TOKEN=


# ══ PROCESSOR ════════════════════════════════════════════════════════

# ── transcription ────────────────────────────────────────────────────
# Same endpoint and model as the machine's existing dictation (hyprwhspr),
# deliberately: one transcription stack, not two. The API key is NOT here —
# it is read from ~/.config/ai/env at runtime.
ATTICUS_STT_URL=https://api.openai.com/v1/audio/transcriptions
# gpt-4o-transcribe ($0.006/min) not gpt-4o-mini-transcribe ($0.003/min).
# Different job from dictation: nobody is waiting on this, so latency is free
# and accuracy is worth buying. A misheard word here silently becomes an
# autonomous agent's instruction — in dictation you'd see and fix it.
# ~$11/yr difference at 20 recordings/day.
ATTICUS_STT_MODEL=gpt-4o-transcribe
ATTICUS_STT_TIMEOUT=60

# Steering prompt. Measurably improves punctuation and capitalization —
# carried over from hyprwhspr's config and extended for instruction-shaped
# audio. Change with care.
ATTICUS_STT_PROMPT=Transcribe with proper capitalization, including sentence beginnings, proper nouns, titles, and standard English capitalization rules. The speaker is dictating a short instruction or request.

# ── the sanity gate ──────────────────────────────────────────────────
# The transcript becomes the agent's prompt, so garbage in means an agent
# acting on garbage.

# Refuse to execute transcripts shorter than this.
ATTICUS_MIN_WORDS=3

# ── length guards ────────────────────────────────────────────────────
# A command is 10-30 seconds and the wake phrase must come FIRST, so
# everything past a couple of minutes is silence or ambient audio nobody
# meant to capture. Observed: a recording left running for 39.6 minutes,
# of which the first ~12s was the actual command.
#
# Over this, the processor transcribes only the FIRST N seconds and flags
# it. Truncate, never reject: rejecting would silently discard a real
# instruction. It also bounds how much of your day can ever reach the
# transcription API or the agent, whatever the device does.
ATTICUS_MAX_COMMAND_SECONDS=180

# Pathological length — ingest will not even download it. Plaud reports
# duration in the listing, so this check is free. 0 disables it.
ATTICUS_MAX_INGEST_SECONDS=7200

# Chunk long recordings instead of truncating them. OFF by default, because
# truncation is correct for a COMMAND: the wake phrase comes first, so
# everything past the opening seconds is silence or ambient conversation, and
# transcribing 40 minutes of your day is wasteful and a privacy problem.
# A DOCUMENT — a meeting, a long dictation — is the opposite case.
# Turn it on globally here, or mark ONE recording by setting
#     "chunk_audio": true
# in its inbox metadata JSON, which leaves global behaviour alone.
ATTICUS_CHUNK_LONG_AUDIO=off

# Chunk length and overlap, seconds. The API caps a request at 1400s, so
# chunk_seconds is clamped to that. Chunks overlap because a hard cut lands
# mid-word about as often as not, and a word split across two requests is
# transcribed wrong in both; the duplicated run is removed when joining.
ATTICUS_CHUNK_SECONDS=1200
ATTICUS_CHUNK_OVERLAP_SECONDS=10



# Optional wake phrase. Empty = execute every transcript that passes the
# word count. Set it (e.g. "atticus") and only transcripts starting with it
# are executed — everything else is filed as an unexecuted note.
#
# STRONGLY recommended for a wearable: without it, an overheard meeting or
# phone call becomes an instruction to an autonomous agent.
ATTICUS_WAKE_PHRASE=atticus

# Known mishearings of the wake phrase, comma-separated, exact-matched.
# Observed: "Atticus, research the best Android phone options" transcribed as
# "Advocates research…" and was silently filed as a note. Add mishearings here
# as you hit them. Fuzzy matching is deliberately NOT used — see config.py.
# Deterministic escape hatch, empty by default: the adjudicator below does
# this job now and caches its verdicts, so the system learns its own aliases.
ATTICUS_WAKE_ALIASES=

# Probabilistic wake-word recovery. When the strict gate fails, ask a small
# model whether the first word could be a MISHEARING of the wake phrase.
# Phonetics only, one word in, one token out, and it fails closed on any
# error. It can only widen the gate, never narrow it. See processor/wake.py.
ATTICUS_WAKE_ADJUDICATOR=on
ATTICUS_WAKE_ADJUDICATOR_MODEL=gpt-4o-mini
ATTICUS_WAKE_ADJUDICATOR_TIMEOUT=15

# Score (0-100) at or above which a misheard first word is admitted. 75, not a
# bare majority: this widens the one control between ambient speech and an
# autonomous agent, and ADR-003 makes it load-bearing for credential safety now
# that the Plaud session shares this host. A false accept executes overheard
# speech; a false reject files a recoverable note. Asymmetric costs, asymmetric
# threshold.
ATTICUS_WAKE_ADJUDICATOR_THRESHOLD=75

# How long an adjudicator verdict stays cached. Verdicts used to be cached
# FOREVER, so a single wrong admit permanently opened that (word, context) pair
# and later passes logged only "cached verdict … admit". 0 disables expiry.
ATTICUS_WAKE_VERDICT_TTL_HOURS=168


# ── execution ────────────────────────────────────────────────────────
# Leave model unset to use the Claude Code default.
ATTICUS_CLAUDE_BIN=claude
ATTICUS_CLAUDE_MODEL=
ATTICUS_EXEC_TIMEOUT=1800

# Tools the agent may use, comma-separated.
# WebSearch/WebFetch are granted deliberately. Denying them bought NO
# security: the sandbox leaves the network namespace intact because research
# needs it, and the agent has bash, curl, python3 and working DNS (verified).
# A tool denial only prevented convenient research while leaving exfiltration
# fully available. Real egress control is a separate piece of work.
ATTICUS_ALLOWED_TOOLS=WebSearch,WebFetch,Read,Write,Edit,Glob,Grep,Bash


# Per-recording ceiling on the AGENT run. BLANK = disabled, which is the default
# and the right answer for most deployments. Read this before setting it.
#
# It is IMPUTED, NOT MONEY. `claude -p` authenticates with the operator's OAuth
# credential, so this counts what the tokens would have cost if they were billed
# per token. No dollars leave any account. The real-money caps are
# ATTICUS_TRANSCRIPTION_BUDGET_USD and ATTICUS_TTS_BUDGET_USD.
#
# It was set to 2.00, then 4.00, and it did net harm at both values. Measured
# 2026-08-01: three research runs were killed by it, two of them producing NOTHING
# after 30-60 turns of genuine work, because the agent researches before it writes.
# One request expanded from 33 turns to 60 when the ceiling doubled and still failed
# — so more headroom got spent, not saved.
#
# What it was protecting against is already covered: ATTICUS_EXEC_TIMEOUT (1800s)
# is a hard wall-clock bound on any single run, and the processor is a 5-minute
# timer working one record at a time, so throughput is bounded too. A runaway loop
# hits the timeout.
#
# The one real cost of an unbounded run is Claude SUBSCRIPTION rate-limit quota —
# if Atticus burns through it, interactive Claude Code on this host gets throttled.
# That is worth watching (`atticus usage` reports imputed spend) but it is not
# worth destroying finished work to prevent, which is what this setting did.
#
# Set it only as a runaway backstop far above any legitimate run — 20.00, say, not
# 2.00. A value near the cost of real work will kill real work.
ATTICUS_MAX_BUDGET_USD=


# ── the outbox: how the agent causes external actions (issue #42) ─────
# The agent holds NO credentials — that is the main control in this system. So a
# skill that needs to send, file or create something writes intent into
# output/outbox/NNN-verb.json and the pipeline performs it afterwards. The intent
# file is committed before anything happens, so git history is the audit trail for
# what was ASKED separately from what was DONE.
#
# "off" records intent and performs nothing. That is how to test a new handler.
ATTICUS_OUTBOX=on

# Per risk class. "auto" performs it unattended; "confirm" records the intent and
# waits for a human — and since nobody is present during a pass, confirm means
# "not this pass".
#   internal  only you see it, trivially undone      (todo, reminder)
#   tracked   others see it, recoverable, expected   (GitHub issue, ADO item)
#   outward   a message to a person, NOT recallable  (Signal, mail, Slack)
# outward defaults to confirm because the instruction comes from a microphone worn
# in public. Read SECURITY.md's prompt-scoping section before changing it.
ATTICUS_OUTBOX_INTERNAL=auto
ATTICUS_OUTBOX_TRACKED=confirm
ATTICUS_OUTBOX_OUTWARD=confirm

# Bound the fan-out: one misheard sentence must not send thirty messages. 0 = no cap.
ATTICUS_OUTBOX_MAX_ACTIONS=5

# ── daily AI briefing ─────────────────────────────────────────────────
# Written at 07:00 local by ops/atticus-brief.timer into the vault's reports/
# directory — NOT processed/, because it is not a recording and inventing a
# synthetic one would put a lie in the audit trail. It inherits site indexing,
# tag filtering, read state and the PDF button from the reports/ path for free.
#
# Always tagged "AI brief". Anything here is added on top, comma-separated.
ATTICUS_BRIEF_TAGS=

# Voice the briefing too? OFF by default, deliberately. Everywhere else audio is
# generated only when ASKED for — a spoken request says "and make me a podcast".
# The briefing has nobody to ask, so defaulting this on created recurring daily
# spend that was never requested. ~$0.05/episode, ~$1.40/month at daily cadence.
ATTICUS_BRIEF_AUDIO=false

# It is an agent run like any other, so ATTICUS_MAX_BUDGET_USD bounds it and the
# usage ledger records it as subscription-billed. Roughly one research-shaped run
# a day; at the ~$1.70-2.00 imputed a report costs, that is most of a month's
# notional agent spend, though it bills nothing per token.
#
# Deduplication lives in .state/brief-covered.jsonl. The agent cannot read the
# vault, so brief.py injects the last 14 days of covered items INTO the prompt and
# appends whatever the agent reports back in covered.json. If that file stops
# being written, briefings silently start repeating themselves — which is why
# brief.py warns loudly rather than shrugging.

# ── audio overview ("podcast") ────────────────────────────────────────
# Opt-in and costs nothing unless used. The agent writes
# output/podcast-script.md only when the spoken request asked to listen to the
# report (see skills/podcast-companion); with no script this stage is a no-op.
#
# Synthesis is pipeline work, NOT a skill, because it needs a credential and the
# agent is denied every credential this host holds. Splitting at the script
# boundary keeps the judgement with the agent and the spend with the pipeline.
#
# NotebookLM has no API. Google's Discovery Engine Podcast API — the only
# programmatic route to a real NotebookLM audio overview — was deprecated in
# 2026 and Google stopped allowlisting. This reproduces the format with TTS.
# Which engine voices the script. Chosen by a blind A/B/C/D on one excerpt,
# 2026-07-31: ElevenLabs v3 won on quality but costs 12x; Gemini beat both OpenAI
# variants AND came out marginally cheaper per episode — not a cheaper rate (both
# are $0.015/min) but faster delivery, so fewer seconds to bill.
#
# It wins for an architectural reason: Gemini takes both speakers in ONE call and
# paces the whole conversation, while OpenAI synthesises one line per call so a
# reply never knows it is a reply. Per-turn styling was tried and came third.
ATTICUS_TTS_PROVIDER=gemini

ATTICUS_GEMINI_TTS_URL=https://generativelanguage.googleapis.com/v1beta/models/{model}:generateContent
ATTICUS_GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
# Voices: Charon (deeper) and Aoede (brighter). They must be clearly distinct or
# the format fails — the listener cannot tell who is asking from who is answering.
ATTICUS_GEMINI_VOICE_A=Charon
ATTICUS_GEMINI_VOICE_B=Aoede
# One call renders the whole episode: a 56-turn script took 162s to return.
ATTICUS_GEMINI_TTS_TIMEOUT=900
# Natural-language direction for the whole conversation, prepended to the script.
# {a} and {b} are substituted with the two speaker names. This is the only steering
# Gemini takes, and it applies to the WHOLE dialogue rather than per line — which
# is the point: it can direct the interaction, not just two separate readings.
ATTICUS_GEMINI_TTS_STYLE=Read this as a natural, brisk two-host podcast conversation. {a} explains and is confident; {b} is curious and slightly skeptical, and reacts quickly. Do not sound like an advertisement.

# 24 kHz mono speech is capped at 12 kHz by the sample rate, so 128 kbps buys
# nothing audible and every episode is a permanent git blob. 48 kbps is
# transparent for two people talking and cuts each file by about 60%.
ATTICUS_TTS_BITRATE_KBPS=48

# OpenAI path, retained as a fallback (ATTICUS_TTS_PROVIDER=openai).
ATTICUS_TTS_URL=https://api.openai.com/v1/audio/speech
ATTICUS_TTS_MODEL=gpt-4o-mini-tts
ATTICUS_TTS_TIMEOUT=120

# Two clearly distinct voices, or the format fails: with similar hosts the
# listener cannot tell who is asking from who is answering. OpenAI voices:
# alloy, ash, ballad, coral, echo, fable, onyx, nova, sage, shimmer, verse.
ATTICUS_TTS_VOICE_A=onyx
ATTICUS_TTS_VOICE_B=nova
ATTICUS_TTS_INSTRUCTIONS=Conversational podcast host. Natural pace, warm but not performative. Do not sound like an advertisement.

# Per-episode ceiling on REAL money, tested against an estimate BEFORE the first
# request. TTS bills to the same key and the same monthly budget as
# transcription, so ATTICUS_API_BUDGET_USD also applies and an exhausted month
# skips audio rather than failing the report. A ten-minute episode is about
# $0.15, so this stops a runaway script rather than a normal one. 0 disables it.
ATTICUS_PODCAST_MAX_USD=0.50

# Hard bound on the prompt handed to the agent, cut at a sentence boundary.
# The FULL transcript is still written to the vault — this only limits how
# much ambient speech can reach an autonomous agent. Observed motivation: a
# 389-word transcript of which ~25 words were the command, and which
# contained "hey Atticus, send a message to <name>" spoken as an example.
ATTICUS_MAX_COMMAND_CHARS=600

# The other half of the same bound, and whichever bites first wins. Undocumented
# until 2026-07-30 even though it is one of the two prompt-scoping limits — the
# character cap was documented and the sentence cap was not.
ATTICUS_MAX_COMMAND_SENTENCES=6

# Contain the agent in a bwrap mount namespace: no $HOME, no ~/.ssh, no
# ~/.config/ai/env, no vault. "off" is a real trade, not a formality — without
# it the agent can read every credential this host holds.
ATTICUS_SANDBOX=on

# Sandbox networking. "host" (default) shares the host network namespace, which
# research needs — but loopback is shared too, so the agent can reach local
# services including the vault's own web UI and the write token baked into its
# pages. "none" unshares the network entirely: correct whenever no skill in use
# needs the internet. The real answer is a netns plus an allowlist proxy, which
# permits egress while denying loopback and the tailnet; this is the interim
# control.
ATTICUS_SANDBOX_NET=host

# Which of the operator's GLOBAL (~/.claude/skills) skills the agent may see.
# Binding the whole directory handed it an inventory of unrelated infrastructure
# — M365 addresses, ntfy topics, provider cost sheets — when only the output
# contract's skill is load-bearing. Blank binds everything.
ATTICUS_GLOBAL_SKILLS=html-artifact-output,dataviz

# Ceiling on what a single utterance may commit. The vault is git, where
# deletion is deliberately hard, so unbounded agent output is permanent. The
# whole collection is refused rather than committing a truncated half of it.
ATTICUS_MAX_OUTPUT_FILES=50
# Total bytes across all collected files. 50 MB — generous for an HTML report,
# far below anything that would bloat the vault's history irreversibly.
ATTICUS_MAX_OUTPUT_BYTES=52428800

ATTICUS_SKILLS_DIR=

# Warn if a recording sits in inbox/ unprocessed longer than this.
# The queue's benefit — the processor may be offline, work waits — is
# also its failure mode: a dead processor looks exactly like an idle
# one. See T-74.
ATTICUS_BACKLOG_ALARM_MINUTES=60

# ── real-money budgets, one per paid service ──────────────────────────
# ONE budget per service, because exhaustion means different things. These were a
# single ATTICUS_API_BUDGET_USD, and that was a bug: TTS spent against the pot the
# transcribe gate checks, so an audio-heavy month would halt the CORE pipeline
# over an optional companion feature.
#
# The agent is in NEITHER. `claude -p` runs on the operator's Claude subscription
# and bills nothing per token; its per-recording bound is ATTICUS_MAX_BUDGET_USD,
# which is imputed, not money. 0 disables a cap.

# Transcription, plus the wake adjudicator (same key, derived from a transcript).
# The pipeline cannot run without this, so exhaustion is a HARD stop needing a
# human. It is pennies — about $0.003 a recording, most of them ten seconds — so
# this is a runaway-loop tripwire, not a ration. It should never be reached.
ATTICUS_TRANSCRIPTION_BUDGET_USD=2.00

# Text-to-speech. Optional, on demand, and the expensive one per unit (about
# $0.05-0.10 an episode). Exhaustion skips ONLY the audio: the transcript, the
# agent run and the published report all still happen — the report just does not
# get an episode attached. Nothing fails and nothing is lost.
ATTICUS_TTS_BUDGET_USD=10.00

# Warn on the way up, not only on arrival, as PERCENTAGES of each budget. One
# setting therefore serves both a $2 cap and a $10 one and keeps meaning the same
# thing after either is changed — the old absolute list was tied to one combined
# budget and silently stopped meaning anything once there were two. Blank disables
# the warnings; the caps still apply.
ATTICUS_BUDGET_ALERT_PCT=50,80,100

# SUPERSEDED — leave blank. Setting it does nothing except print a warning at
# startup. It was one pot for transcription AND text-to-speech, which is exactly
# the bug the two budgets above fix: audio spend could stop transcription.
ATTICUS_API_BUDGET_USD=


# ══ W8 — Plaud Embedded, CONTINGENT ══════════════════════════════════
#
# From the Plaud Developer Portal. NOT read by v1 — the iOS app is
# contingent and unbuilt (see ADR-001). Parked here so the credentials
# have one home rather than three. Belongs with the ingest role if it
# ever fires, since W8's upload endpoint lands there too (T-84).
#
# Uncomment only when W8 actually triggers.

# PLAUD_EMBEDDED_CLIENT_ID=
# PLAUD_EMBEDDED_CLIENT_SECRET=
# PLAUD_EMBEDDED_API_KEY=
# PLAUD_EMBEDDED_API_HOST=


# ══ Not configured here ══════════════════════════════════════════════
#
# Claude Code auth — the processor shells out to `claude -p`, which uses
# its own credential store on that host. Do not duplicate an API key here.
#
# GitHub auth — one deploy key per host in ~/.ssh, not here. Two keys,
# both with write access to atticus-vault, independently revocable.
